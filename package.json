{
  "name": "kanso-web",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "astro build && wrangler pages deploy dist --project-name kanso",
    "planner:local": "astro build && wrangler pages dev dist --d1 PLANNER_DB=00000000-0000-0000-0000-000000000000 --r2 PLANNER_BUCKET --persist-to .wrangler/state --port 8788"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.8",
    "@astrojs/sitemap": "^3.7.4",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/bodoni-moda": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "wrangler": "^4.160.1"
  }
}
