---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import hero from '../assets/img/servicios-hero.jpg';
import diseno from '../assets/img/servicios-diseno.jpg';
import negocio from '../assets/img/servicios-negocio.jpg';
import produccion from '../assets/img/servicios-produccion.png';
import og from '../assets/img/og-servicios.jpg';

const servicios = [
  {
    img: diseno, alt: 'Taza de cerámica KANSO con latte art',
    titulo: 'Diseñamos y desarrollamos tu proyecto a medida',
    bajada: 'Ten tu producto propio y eleva el nivel de tu marca',
    texto: 'Brindamos un servicio de diseño personalizado para dar vida a las ideas, a través de un proceso de diseño creativo altamente colaborativo.',
  },
  {
    img: negocio, alt: 'Piezas de cerámica KANSO en un espacio gastronómico',
    titulo: 'Suma nuestros productos a tu negocio',
    bajada: 'Más valor a tus servicios',
    texto: 'Trabajamos en colaboración con profesionales de diseño, arquitectura y decoración, para mejorar su oferta de servicios dándoles la oportunidad de incorporar piezas únicas y sumar un valor diferencial.',
  },
  {
    img: produccion, alt: 'Serie de piezas de cerámica KANSO producidas por pedido',
    titulo: 'Desarrollo y producción por pedido',
    bajada: 'Desarrolla tu producto propio y eleva el nivel de tu marca',
    texto: 'Brindamos asesoramiento y asistencia personalizada para cada cliente, ofreciendo productos que se adapten a cada necesidad.',
  },
];
---
<Base title="Servicios" description="Diseño a medida, vajilla para gastronomía y producción de cerámica por pedido para proyectos, negocios y marcas." ogImage={og}>
  <header class="page-title servicios-title bg-beige">
    <h1>Servicios</h1>
    <p class="label">Agregamos valor a proyectos, negocios y marcas</p>
  </header>

  <section class="container grid-12 destacado">
    <Image src={hero} alt="Jarro de cerámica KANSO servido con pan" widths={[480, 720, 1080]} sizes="(max-width: 799px) 100vw, 560px" class="destacado__img" />
    <div class="destacado__card">
      <p class="label">Diseño a medida</p>
      <h2>Tu idea hecha realidad</h2>
      <p>Agregamos valor a proyectos, negocios y marcas.</p>
      <a class="btn btn--light" href={site.whatsappAR} target="_blank" rel="noopener">Consultanos, ¡podemos asesorarte!</a>
    </div>
  </section>

  <section class="container servicios">
    {servicios.map((s) => (
      <article class="servicio grid-12">
        <Image src={s.img} alt={s.alt} widths={[320, 640]} sizes="(max-width: 799px) 100vw, 280px" class="servicio__img" />
        <div class="servicio__texto">
          <h2>{s.titulo}</h2>
          <p class="servicio__bajada">{s.bajada}</p>
          <p>{s.texto}</p>
        </div>
      </article>
    ))}
  </section>
</Base>

<style>
  /* La banda del título se alarga y la foto con la tarjeta arranca dentro de ella:
     título y destacado se leen como un solo bloque. */
  .servicios-title { padding-bottom: calc(var(--s-8) + var(--s-12)); }
  .destacado { position: relative; margin-top: calc(-1 * var(--s-12)); padding-bottom: var(--section); }

  /* Foto 4:5 con la tarjeta superpuesta, desplazada a la derecha */
  .destacado { row-gap: 0; }
  .destacado__img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; }
  .destacado__card { background: var(--c-accent-dark); color: var(--c-white); padding: var(--s-6) var(--s-4); }
  .destacado__card .label { color: var(--c-beige); }
  .destacado__card p:not(.label) { margin-bottom: var(--s-4); }

  .servicios { padding-bottom: var(--section); }
  .servicio { padding-block: var(--s-6); border-top: 1px solid var(--c-line); row-gap: var(--s-3); }
  .servicio:last-child { border-bottom: 1px solid var(--c-line); }
  .servicio__img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; }
  /* Ancho acotado para que todos los títulos queden en dos líneas parejas */
  .servicio__texto h2 { font-size: var(--fs-h3); text-wrap: balance; max-width: 24ch; }
  .servicio__bajada { font-weight: var(--fw-medium); }

  @media (min-width: 800px) {
    .servicios-title { padding-bottom: calc(var(--s-8) + var(--s-16)); }
    .destacado { margin-top: calc(-1 * var(--s-16)); }
    .destacado__img { grid-column: 1 / 7; grid-row: 1; }
    .destacado__card { grid-column: 6 / 12; grid-row: 1; align-self: center; padding: var(--s-8) var(--s-6); }

    .servicio { padding-block: var(--s-8); align-items: center; }
    .servicio__img { grid-column: 1 / 4; }
    .servicio__texto { grid-column: 5 / 12; }
  }
</style>
