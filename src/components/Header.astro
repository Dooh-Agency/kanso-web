---
import Logo from '../assets/logos/kanso-logo.svg';
import { nav } from '../data/site';
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
---
<header class="header">
  <div class="header__inner">
    <a href="/" class="header__logo" aria-label="KANSO Studio, inicio">
      <Logo width="145" height="31" aria-hidden="true" />
    </a>
    <button class="header__toggle" aria-expanded="false" aria-controls="menu">
      <span class="sr-only">Abrir menú</span>
      <span></span><span></span><span></span>
    </button>
    <nav id="menu" class="header__nav" aria-label="Principal">
      <ul>
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={!item.external && path === item.href ? 'page' : undefined}
              {...(item.external ? { target: '_blank', rel: 'noopener' } : {})}
            >{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .header { position: sticky; top: 0; z-index: 50; background: rgba(255,255,255,.96); backdrop-filter: blur(6px); }
  .header__inner { max-width: var(--max); margin: 0 auto; padding: 22px var(--pad) 18px; display: flex; flex-direction: column; align-items: center; gap: 18px; }
  .header__logo { display: block; line-height: 0; }
  .header__nav ul { list-style: none; margin: 0; padding: 0; display: flex; gap: clamp(16px, 3vw, 36px); flex-wrap: wrap; justify-content: center; }
  .header__nav a {
    font-family: var(--f-label); font-size: 10px; letter-spacing: .14em; text-transform: uppercase;
    text-decoration: none; color: var(--c-text); padding-bottom: 3px; border-bottom: 1px solid transparent;
  }
  .header__nav a:hover, .header__nav a[aria-current='page'] { color: var(--c-accent); border-bottom-color: var(--c-accent); }
  .header__toggle { display: none; }

  @media (max-width: 760px) {
    .header__inner { flex-direction: row; justify-content: space-between; padding-block: 16px; }
    .header__logo :global(svg) { width: 120px; height: auto; }
    .header__toggle { display: flex; flex-direction: column; gap: 5px; background: none; border: 0; padding: 8px; cursor: pointer; }
    .header__toggle span:not(.sr-only) { width: 22px; height: 1.5px; background: var(--c-text); display: block; }
    .header__nav { display: none; position: absolute; top: 100%; left: 0; right: 0; background: #fff; border-top: 1px solid var(--c-line); }
    .header__nav.is-open { display: block; }
    .header__nav ul { flex-direction: column; align-items: center; gap: 0; padding: 12px 0 20px; }
    .header__nav li a { display: block; padding: 12px; font-size: 12px; }
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.header__toggle');
  const menu = document.getElementById('menu');
  btn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('is-open') ?? false;
    btn.setAttribute('aria-expanded', String(open));
  });
</script>
