---
import Wordmark from '../assets/logos/kanso-wordmark.svg';
import { site } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="footer bg-beige" id="contacto">
  <div class="container footer__grid">
    <div>
      <a href="/" aria-label="KANSO, inicio"><Wordmark width="124" height="17" aria-hidden="true" /></a>
      <p class="footer__small">
        <a href={`mailto:${site.email}`}>{site.email}</a><br />
        <a href="/">kanso.ar</a>
      </p>
    </div>
    <div>
      <p class="footer__city">Buenos Aires, Argentina</p>
      <a class="link-accent" href={site.whatsappAR} target="_blank" rel="noopener">{site.telAR}</a>
    </div>
    <div>
      <p class="footer__city">Málaga, España</p>
      <a class="link-accent" href={site.whatsappES} target="_blank" rel="noopener">{site.telES}</a>
    </div>
    <div class="footer__end">
      <a href={site.instagram} target="_blank" rel="noopener" aria-label="Instagram de KANSO">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".8" fill="currentColor"/></svg>
      </a>
      <a href="#main" class="footer__top" aria-label="Volver arriba">↑</a>
      <p class="footer__small">© {year} by KANSO Studio</p>
    </div>
  </div>
</footer>

<style>
  .footer { padding: 48px 0 40px; margin-top: 0; }
  .footer__grid { display: grid; grid-template-columns: 1.2fr 1fr 1fr auto; gap: 32px; align-items: end; }
  .footer__small { font-size: 11px; margin: 14px 0 0; line-height: 1.8; }
  .footer__small a { text-decoration: none; }
  .footer__city { font-size: 11px; margin: 0; }
  .footer__city::before { content: '⌖ '; color: var(--c-text); }
  .footer .link-accent { font-size: 11px; }
  .footer__end { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; justify-content: flex-end; }
  .footer__end .footer__small { margin: 0; width: 100%; text-align: right; }
  .footer__top { width: 26px; height: 26px; border: 1px solid currentColor; border-radius: 50%; display: grid; place-items: center; text-decoration: none; font-size: 12px; }
  @media (max-width: 760px) {
    .footer__grid { grid-template-columns: 1fr 1fr; }
    .footer__end { justify-content: flex-start; }
    .footer__end .footer__small { text-align: left; }
  }
</style>
