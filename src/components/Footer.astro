---
import Wordmark from '../assets/logos/kanso-wordmark.svg';
import { site } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="footer bg-beige" id="contacto">
  <div class="container footer__grid">
    <div>
      <a href="/" aria-label="KANSO, inicio"><Wordmark width="124" height="17" aria-hidden="true" /></a>
      <p class="footer__small">
        <a href={`mailto:${site.email}`}>{site.email}</a><br />
        <a href="/">kanso.ar</a>
      </p>
    </div>
    <div>
      <p class="label">Buenos Aires,<br />Argentina</p>
      <a class="link-accent" href={site.whatsappAR} target="_blank" rel="noopener">{site.telAR}</a>
    </div>
    <div>
      <p class="label">Málaga,<br />España</p>
      <a class="link-accent" href={site.whatsappES} target="_blank" rel="noopener">{site.telES}</a>
    </div>
    <div class="footer__end">
      <a href={site.instagram} target="_blank" rel="noopener" class="footer__circle" aria-label="Instagram de KANSO">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".8" fill="currentColor"/></svg>
      </a>
      <a href="#main" class="footer__circle" aria-label="Volver arriba">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 19V5M6 11l6-6 6 6"/></svg>
      </a>
      <p class="footer__small">© {year} KANSO Studio</p>
    </div>
  </div>
</footer>

<style>
  .footer { padding-block: var(--s-8) var(--s-6); }
  .footer__grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s-4); align-items: end; }
  .footer__small { font-size: var(--fs-small); margin: var(--s-2) 0 0; }
  .footer__small a { text-decoration: none; }
  .footer .label { margin-bottom: var(--s-1); }
  .footer__end { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-2); }
  .footer__end .footer__small { margin: 0; width: 100%; }
  /* Botones circulares con ícono: excepción a la regla de bordes redondeados e íconos, pedida para el pie */
  .footer__circle { width: 40px; height: 40px; border: 1px solid currentColor; border-radius: 50%; display: grid; place-items: center; color: var(--c-text); transition: color .2s, border-color .2s; }
  .footer__circle:hover { color: var(--c-accent); }
  @media (min-width: 800px) {
    .footer__grid { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); }
    .footer__grid > :nth-child(1) { grid-column: 1 / 5; }
    .footer__grid > :nth-child(2) { grid-column: 5 / 8; }
    .footer__grid > :nth-child(3) { grid-column: 8 / 10; }
    .footer__end { grid-column: 10 / 13; justify-content: flex-end; text-align: right; }
  }
</style>
