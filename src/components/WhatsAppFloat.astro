---
import WhatsApp from '../assets/logos/whatsapp.svg';
import { site } from '../data/site';
---
<a class="wa" href={site.whatsappAR} target="_blank" rel="noopener" aria-label="Escribinos por WhatsApp">
  <WhatsApp width="24" height="24" aria-hidden="true" />
</a>

<style>
  .wa {
    position: fixed; right: var(--s-3); bottom: var(--s-3); z-index: 60;
    width: 48px; height: 48px; background: var(--c-white); border: 1px solid var(--c-line);
    display: grid; place-items: center; transition: background .2s;
  }
  .wa:hover { background: var(--c-beige); }
  .wa :global(svg) { fill: var(--c-accent); }
</style>
